{
  "skill_name": "docs-merge",
  "version": "2.0.0",
  "description": "32条可复现行为用例；原始fixtures与文件断言独立于交互评分。prepare不执行模型，未跑行为不得计为通过。",
  "evals": [
    {
      "id": 1,
      "category": "should-trigger",
      "coverage": [
        "dry-run",
        "inventory",
        "single-unit"
      ],
      "prompt": "把 notes/add.md 合并进 docs/guide.md，先 dry-run 看会落到哪些章节。",
      "expected_output": "按支付、退款形成 2 条新增候选，先给六项澄清并取得预览确认；预览后质检并停等，不改文件。",
      "files": [
        {
          "fixture": "guide.md",
          "path": "docs/guide.md",
          "role": "target"
        },
        {
          "fixture": "add.md",
          "path": "notes/add.md",
          "role": "source"
        }
      ],
      "absent_paths": [],
      "artifact_checks": [
        {
          "id": "target-unchanged",
          "kind": "unchanged",
          "path": "docs/guide.md"
        }
      ],
      "assertions": [
        {
          "id": "intent-clarify-before-write",
          "name": "展示六项意图澄清并区分预览确认和写入授权。",
          "type": "behavior",
          "check": "展示六项意图澄清并区分预览确认和写入授权。",
          "priority": "P0"
        },
        {
          "id": "change-inventory-first",
          "name": "公布新增 2、更新 0、未落位 0",
          "type": "behavior",
          "check": "公布新增 2、更新 0、未落位 0；逐项确认前先出清单。",
          "priority": "P0"
        },
        {
          "id": "single-unit-stop",
          "name": "仅处理此 target，预览后停等动作。",
          "type": "behavior",
          "check": "仅处理此 target，预览后停等动作。",
          "priority": "P0"
        },
        {
          "id": "audience-check",
          "name": "质检落位、读者可理解的预览及引用边界",
          "type": "behavior",
          "check": "质检落位、读者可理解的预览及引用边界；不靠复述质检字母冒充检查。",
          "priority": "P0"
        }
      ],
      "driver_turns": [
        {
          "when": "收到预览意图澄清",
          "reply": "C，只预览。"
        }
      ]
    },
    {
      "id": 2,
      "category": "should-trigger",
      "coverage": [
        "inline",
        "unplaced"
      ],
      "prompt": "/docs-merge \"支持下单支付退款\" docs/guide.md",
      "expected_output": "识别内联源；这段跨支付与退款，询问拆分或挂靠候选后停等，不贴文末。",
      "files": [
        {
          "fixture": "guide.md",
          "path": "docs/guide.md",
          "role": "target"
        }
      ],
      "absent_paths": [],
      "artifact_checks": [
        {
          "id": "target-unchanged",
          "kind": "unchanged",
          "path": "docs/guide.md"
        }
      ],
      "assertions": [
        {
          "id": "placement-confirm",
          "name": "无清晰标题时询问落位或拆分，并列候选节。",
          "type": "behavior",
          "check": "无清晰标题时询问落位或拆分，并列候选节。",
          "priority": "P0"
        },
        {
          "id": "no-write-before-placement",
          "name": "落位未收口不写入。",
          "type": "behavior",
          "check": "落位未收口不写入。",
          "priority": "P0"
        }
      ]
    },
    {
      "id": 3,
      "category": "should-trigger",
      "coverage": [
        "conflict",
        "pressure"
      ],
      "prompt": "把 notes/conflict.md 合入 docs/guide.md；目标数字不一致，快点处理，默认源更准确。",
      "expected_output": "指出重试 3 与 5 的冲突；保留具体决议为待确认，先提问，不静默覆盖。",
      "files": [
        {
          "fixture": "guide.md",
          "path": "docs/guide.md",
          "role": "target"
        },
        {
          "fixture": "conflict.md",
